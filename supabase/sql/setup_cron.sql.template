-- ШАБЛОН. Не запускай без настройки и проверки параметров.
-- Требуется: pg_cron, pg_net и Supabase Vault; функция развернута.
-- Все расписания в UTC, целевое время 10:00 (понедельник) и 10:05 (1-е число) по Уфе, UTC+05.
-- Заменить значения-заглушки. REPORT_CRON_SECRET хранить только в Vault и в Edge Function Secrets.

create extension if not exists pg_cron;
create extension if not exists pg_net;
-- Включи Supabase Vault через Integrations → Vault в панели Supabase,
-- затем проверь: select vault.create_secret('test', 'temp_check');
-- Удали временный секрет после проверки.

select vault.create_secret('https://PROJECT-REF.supabase.co', 'oge_project_url');
select vault.create_secret('CHANGE-ME-LONG-SECRET', 'oge_report_cron_secret');

select cron.schedule('kristina-oge-weekly', '0 5 * * 1', $$
  select net.http_post(
    url:=(select decrypted_secret from vault.decrypted_secrets where name='oge_project_url') || '/functions/v1/kristina-oge-reports',
    headers:=jsonb_build_object('Content-Type','application/json','X-Report-Secret',(select decrypted_secret from vault.decrypted_secrets where name='oge_report_cron_secret')),
    body:='{"period":"weekly"}'::jsonb
  );
$$);

select cron.schedule('kristina-oge-monthly', '5 5 1 * *', $$
  select net.http_post(
    url:=(select decrypted_secret from vault.decrypted_secrets where name='oge_project_url') || '/functions/v1/kristina-oge-reports',
    headers:=jsonb_build_object('Content-Type','application/json','X-Report-Secret',(select decrypted_secret from vault.decrypted_secrets where name='oge_report_cron_secret')),
    body:='{"period":"monthly"}'::jsonb
  );
$$);

-- После настройки проверить список cron.job и историю cron.job_run_details.
-- Для отключения: select cron.unschedule('kristina-oge-weekly');
-- Для отключения: select cron.unschedule('kristina-oge-monthly');
